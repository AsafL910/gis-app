# Build from standard Python slim — GDAL is installed via apt
FROM python:3.12-slim

# Install GDAL system libraries + build tools for the Python bindings
RUN apt-get update && apt-get install -y --no-install-recommends \
        gdal-bin \
        libgdal-dev \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps — GDAL version must match the system package
RUN GDAL_VERSION=$(gdal-config --version) && \
    pip install --no-cache-dir \
        fastapi \
        uvicorn \
        "GDAL==${GDAL_VERSION}"

COPY src/ ./src/

EXPOSE 8001

CMD ["uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "8001"]
